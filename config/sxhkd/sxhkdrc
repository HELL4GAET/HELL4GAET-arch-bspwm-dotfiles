# reload sxhkd
super + Escape
    pkill -USR1 -x sxhkd; notify-send sxhkd "Config reloaded" -t 1200

# apps
super + Return
    alacritty

super + d
    rofi -show drun

super + shift + d
    rofi -show run

super + shift + Return
    rofi -show window

super + shift + f
    firefox

super + shift + c
    code

super + shift + n
    thunar

super + shift + p
    pavucontrol

super + shift + b
    blueman-manager

super + shift + x
    powermenu

super + shift + l
    lock

# screenshots and clipboard
Print
    flameshot gui

super + Print
    screenshot-full

super + shift + Print
    screenshot-area

super + shift + a
    screenshot-area

# audio and brightness
XF86AudioRaiseVolume
    volume up

XF86AudioLowerVolume
    volume down

XF86AudioMute
    volume mute

XF86MonBrightnessUp
    brightness up

XF86MonBrightnessDown
    brightness down

# bspwm session
ctrl + shift + q
    bspc quit

ctrl + shift + r
    bspc wm -r

super + q
    bspc node -c

super + shift + q
    bspc node -k

# layouts and state
super + space
    bspc node -t '~'{floating,tiled}

super + {t,shift + t,f}
    bspc node -t {tiled,pseudo_tiled,fullscreen}

# focus and swap
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Alt+Tab is handled by alttab.

super + {grave,Tab}
    bspc {node,desktop} -f last

# desktops
super + {1-5}
    bspc desktop -f {1-5}

super + shift + {1-5}
    bspc node -d {1-5} --follow

# resize
super + ctrl + h
    if bspc query -N -n west.local >/dev/null; then bspc node -z left -30 0; else bspc node -z right -30 0; fi

super + ctrl + j
    if bspc query -N -n south.local >/dev/null; then bspc node -z bottom 0 30; else bspc node -z top 0 30; fi

super + ctrl + k
    if bspc query -N -n north.local >/dev/null; then bspc node -z top 0 -30; else bspc node -z bottom 0 -30; fi

super + ctrl + l
    if bspc query -N -n east.local >/dev/null; then bspc node -z right 30 0; else bspc node -z left 30 0; fi
