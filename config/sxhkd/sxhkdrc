# reload sxhkd
super + Escape
    pkill -USR1 -x sxhkd; notify-send sxhkd "Config reloaded" -t 1200

# apps
super + Return
    alacritty

super + d
    rofi -show drun

super + shift + d
    rofi -show run

super + shift + Return
    rofi -show window

super + shift + f
    firefox

super + shift + c
    code

super + shift + n
    thunar

super + shift + a
    pavucontrol

super + shift + b
    blueman-manager

super + shift + x
    powermenu

# screenshots and clipboard
Print
    flameshot gui

super + Print
    screenshot-full

super + shift + Print
    screenshot-area

# audio and brightness
XF86AudioRaiseVolume
    volume up

XF86AudioLowerVolume
    volume down

XF86AudioMute
    volume mute

XF86MonBrightnessUp
    brightness up

XF86MonBrightnessDown
    brightness down

# bspwm session
ctrl + shift + q
    bspc quit

ctrl + shift + r
    bspc wm -r

super + q
    bspc node -c

super + shift + q
    bspc node -k

# layouts and state
super + space
    bspc node -t '~'{floating,tiled}

super + {t,shift + t,f}
    bspc node -t {tiled,pseudo_tiled,fullscreen}

# focus and swap
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

alt + {_,shift + }Tab
    bspc node -f {next.local,prev.local}

super + {grave,Tab}
    bspc {node,desktop} -f last

# desktops
super + {1-5}
    bspc desktop -f '^{1-5}'

super + shift + {1-5}
    bspc node -d '^{1-5}' --follow

# resize
super + ctrl + {h,j,k,l}
    bspc node -z {left -30 0,bottom 0 30,top 0 -30,right 30 0}

super + alt + {h,j,k,l}
    bspc node -z {right -30 0,top 0 30,bottom 0 -30,left 30 0}
