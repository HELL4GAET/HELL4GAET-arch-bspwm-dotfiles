#!/bin/sh

export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"

start_once() {
    command -v "$1" >/dev/null 2>&1 || return 0
    if ! pgrep -x "$1" >/dev/null; then
        "$@" &
    fi
}

pgrep -x sxhkd >/dev/null || sxhkd &

xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
xsetroot -cursor_name left_ptr
setxkbmap -I"$HOME/.xkb" -layout us,ructrl -option grp:alt_shift_toggle,caps:ctrl_modifier,terminate:ctrl_alt_bksp -print \
    | xkbcomp -I"$HOME/.xkb" -w 0 - "$DISPLAY" 2>/dev/null || true
xmodmap -e 'keycode 191 = ISO_Next_Group' 2>/dev/null || true
xset r rate 180 45

bspc config border_width 4
bspc config window_gap 17
bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle false
bspc config focus_follows_pointer true
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner

bspc config normal_border_color "#222029"
bspc config active_border_color "#4f7ec7"
bspc config focused_border_color "#6ea8ff"
bspc config presel_feedback_color "#8fc7ff"

primary_monitor="$(bspc query -M --names | head -n 1)"
if [ -n "$primary_monitor" ]; then
    bspc monitor "$primary_monitor" -d 1 2 3 4 5
fi

bspc rule -a feh state=floating
bspc rule -a Pavucontrol state=floating center=true
bspc rule -a Blueman-manager state=floating center=true
bspc rule -a Lxappearance state=floating center=true
wallpaper

pgrep -x dunst >/dev/null || dunst &
pgrep -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" &
start_once alttab -w 1 -d 0 -sc 0
"$HOME/.config/polybar/launch.sh" &
start_once nm-applet
start_once blueman-applet
start_once flameshot
