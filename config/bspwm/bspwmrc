#!/bin/sh

export PATH="$HOME/.local/bin:$PATH"

start_once() {
    command -v "$1" >/dev/null 2>&1 || return 0
    if ! pgrep -x "$1" >/dev/null; then
        "$@" &
    fi
}

pgrep -x sxhkd >/dev/null || sxhkd &

xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
xsetroot -cursor_name left_ptr
setxkbmap -layout us,ru -option grp:alt_shift_toggle,terminate:ctrl_alt_bksp

monitors

bspc config border_width 5
bspc config window_gap 17
bspc config split_ratio 0.52
bspc config borderless_monocle true
bspc config gapless_monocle false
bspc config focus_follows_pointer true
bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action3 resize_corner

bspc config normal_border_color "#1f222b"
bspc config active_border_color "#bd93f9"
bspc config focused_border_color "#7899FA"
bspc config presel_feedback_color "#6272a4"

bspc rule -a feh state=floating
bspc rule -a Pavucontrol state=floating center=true
bspc rule -a Blueman-manager state=floating center=true
bspc rule -a Lxappearance state=floating center=true

wallpaper

pgrep -x dunst >/dev/null || dunst &
pgrep -x picom >/dev/null || picom --config "$HOME/.config/picom/picom.conf" &
"$HOME/.config/polybar/launch.sh" &
start_once nm-applet
start_once blueman-applet
start_once flameshot
