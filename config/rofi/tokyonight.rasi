@import "colors-generated.rasi"

* {
    background: @generated-background;
    surface: @generated-surface;
    surface-alt: #313244;
    foreground: @generated-foreground;
    muted: #6c7086;
    blue: @generated-primary;
    cyan: #89dceb;
    red: #f28fad;
}

window {
    width: 720px;
    border: 2px;
    border-color: @blue;
    border-radius: 18px;
    padding: 18px;
    background-color: @background;
}

mainbox {
    spacing: 14px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    background-color: @surface;
}

prompt {
    text-color: @cyan;
    background-color: transparent;
}

entry {
    placeholder: "Search applications";
    placeholder-color: @muted;
    text-color: @foreground;
    background-color: transparent;
}

listview {
    lines: 6;
    columns: 2;
    spacing: 8px;
    fixed-height: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    spacing: 12px;
    padding: 11px 14px;
    border-radius: 12px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal,
element selected.active {
    background-color: @surface-alt;
    text-color: #ffffff;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @blue;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @red;
}

element selected.urgent {
    background-color: @red;
    text-color: #1e1d2f;
}

element-icon {
    size: 30px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

mode-switcher {
    spacing: 8px;
    background-color: transparent;
}

button {
    padding: 8px 12px;
    border-radius: 10px;
    background-color: @surface;
    text-color: @muted;
}

button selected {
    background-color: @surface-alt;
    text-color: #ffffff;
}
