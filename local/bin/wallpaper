#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="$HOME/.config/bspwm/wallpapers"
fallback="$HOME/.config/bspwm/wallpaper.png"

if [[ "${1:-}" == "--random" && -d "$wallpaper_dir" ]]; then
  mapfile -t images < <(find "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.png' \) | sort)
  if ((${#images[@]} > 0)); then
    selected="${images[RANDOM % ${#images[@]}]}"
    ln -sf "$selected" "$fallback"
  fi
fi

if [[ -e "$fallback" ]]; then
  feh --bg-fill "$fallback"
else
  xsetroot -solid "#1e222a"
fi
