#!/usr/bin/env bash
set -euo pipefail

choice="$(printf 'Lock\nLogout\nSuspend\nReboot\nShutdown' |
  rofi -dmenu -p power -theme "$HOME/.config/rofi/tokyonight.rasi")"

case "$choice" in
  Lock)
    lock
    ;;
  Logout)
    bspc quit
    ;;
  Suspend)
    lock &
    for _ in {1..20}; do
      pgrep -x i3lock >/dev/null && break
      sleep 0.1
    done
    systemctl suspend
    ;;
  Reboot)
    systemctl reboot
    ;;
  Shutdown)
    systemctl poweroff
    ;;
esac
