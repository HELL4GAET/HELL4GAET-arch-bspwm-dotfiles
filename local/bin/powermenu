#!/usr/bin/env bash
set -euo pipefail

choice="$(printf 'Lock\nLogout\nSuspend\nReboot\nShutdown' \
  | rofi -dmenu -p power -theme "$HOME/.config/rofi/tokyonight.rasi")"

case "$choice" in
  Lock)
    lock
    ;;
  Logout)
    bspc quit
    ;;
  Suspend)
    systemctl suspend
    ;;
  Reboot)
    systemctl reboot
    ;;
  Shutdown)
    systemctl poweroff
    ;;
esac
