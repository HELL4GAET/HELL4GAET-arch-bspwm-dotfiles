#!/usr/bin/env bash
set -euo pipefail

mode="${1:-}"

case "$mode" in
  big)
    xft_dpi=144
    st_pixelsize=22
    gtk_font="JetBrainsMono Nerd Font 14"
    rofi_font="JetBrainsMono Nerd Font 16"
    alacritty_font="14.0"
    kitty_font="15.0"
    dunst_font="JetBrainsMono Nerd Font 16"
    polybar_height=36
    polybar_border=9
    polybar_font0=17
    polybar_font1=23
    polybar_font2=17
    polybar_font3=17
    bspwm_top_padding=54
    ;;
  normal)
    xft_dpi=100
    st_pixelsize=20
    gtk_font="JetBrainsMono Nerd Font 12"
    rofi_font="JetBrainsMono Nerd Font 14"
    alacritty_font="15.0"
    kitty_font="13.5"
    dunst_font="JetBrainsMono Nerd Font 15"
    polybar_height=26
    polybar_border=7
    polybar_font0=13
    polybar_font1=18
    polybar_font2=13
    polybar_font3=13
    bspwm_top_padding=40
    ;;
  *)
    echo "Usage: ui-size [big|normal]" >&2
    exit 2
    ;;
esac

if [[ -f "$HOME/.Xresources" ]]; then
  sed -i "s/^Xft.dpi:.*/Xft.dpi:   $xft_dpi/" "$HOME/.Xresources"
  sed -i "s/^st.font:.*/st.font:         JetBrainsMono Nerd Font:style:medium:pixelsize=$st_pixelsize/" "$HOME/.Xresources"
  xrdb -merge "$HOME/.Xresources" 2>/dev/null || true
fi

for gtk_settings in "$HOME/.config/gtk-3.0/settings.ini" "$HOME/.config/gtk-4.0/settings.ini"; do
  if [[ -f "$gtk_settings" ]]; then
    sed -i "s/^gtk-font-name=.*/gtk-font-name=$gtk_font/" "$gtk_settings"
  fi
done

if [[ -f "$HOME/.config/rofi/config.rasi" ]]; then
  sed -i "s/font: \".*\";/font: \"$rofi_font\";/" "$HOME/.config/rofi/config.rasi"
fi

if [[ -f "$HOME/.config/alacritty/alacritty.toml" ]]; then
  sed -i "s/^size = .*/size = $alacritty_font/" "$HOME/.config/alacritty/alacritty.toml"
fi

if [[ -f "$HOME/.config/kitty/kitty.conf" ]]; then
  sed -i "s/^font_size .*/font_size $kitty_font/" "$HOME/.config/kitty/kitty.conf"
fi

if [[ -f "$HOME/.config/dunst/dunstrc" ]]; then
  sed -i "s/^  font = .*/  font = $dunst_font/" "$HOME/.config/dunst/dunstrc"
fi

if [[ -f "$HOME/.config/polybar/config.ini" ]]; then
  sed -i "s/^height = .*/height = $polybar_height/" "$HOME/.config/polybar/config.ini"
  sed -i "s/^border-top-size = .*/border-top-size = $polybar_border/" "$HOME/.config/polybar/config.ini"
  sed -i "s/^border-bottom-size = .*/border-bottom-size = $polybar_border/" "$HOME/.config/polybar/config.ini"
  sed -i "s/^font-0 = .*/font-0 = JetBrainsMono Nerd Font:style=Bold:pixelsize=$polybar_font0;3/" "$HOME/.config/polybar/config.ini"
  sed -i "s/^font-1 = .*/font-1 = JetBrainsMono Nerd Font:size=$polybar_font1;5/" "$HOME/.config/polybar/config.ini"
  sed -i "s/^font-2 = .*/font-2 = JetBrainsMono Nerd Font:style=Bold:size=$polybar_font2;3/" "$HOME/.config/polybar/config.ini"
  sed -i "s/^font-3 = .*/font-3 = unifont:fontformat=truetype:size=$polybar_font3:antialias=true;/" "$HOME/.config/polybar/config.ini"
fi

if command -v bspc >/dev/null 2>&1; then
  bspc config top_padding "$bspwm_top_padding" 2>/dev/null || true
fi

"$HOME/.config/polybar/launch.sh" 2>/dev/null || true
pkill -x dunst 2>/dev/null || true
command -v dunst >/dev/null 2>&1 && dunst >/dev/null 2>&1 &
