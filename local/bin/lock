#!/usr/bin/env bash
set -euo pipefail

wallpaper="$HOME/.config/bspwm/wallpaper.png"
image_args=(-c 1e222aff)

if [[ -e "$wallpaper" ]]; then
  image_args=(-i "$wallpaper" --fill)
fi

(
  sleep 8
  xset dpms force off
) &

i3lock \
  -n \
  -e \
  "${image_args[@]}" \
  --clock \
  --indicator \
  --radius 120 \
  --ring-width 7 \
  --ind-pos="x+w/2:y+h*0.58" \
  --time-pos="x+w/2:y+h*0.24" \
  --date-pos="tx:ty+54" \
  --greeter-pos="x+w/2:y+h*0.43" \
  --time-str="%H:%M" \
  --date-str="%A, %d %B" \
  --greeter-text="Locked" \
  --verif-text="Checking" \
  --wrong-text="Wrong password" \
  --noinput-text="" \
  --lock-text="Locking" \
  --lockfailed-text="Lock failed" \
  --time-font="JetBrainsMono Nerd Font" \
  --date-font="JetBrainsMono Nerd Font" \
  --greeter-font="JetBrainsMono Nerd Font" \
  --verif-font="JetBrainsMono Nerd Font" \
  --wrong-font="JetBrainsMono Nerd Font" \
  --time-size=74 \
  --date-size=22 \
  --greeter-size=24 \
  --verif-size=18 \
  --wrong-size=18 \
  --time-color=ffffffff \
  --date-color=d8dee9ff \
  --greeter-color=e5e9f0ff \
  --verif-color=88c0d0ff \
  --wrong-color=bf616aff \
  --inside-color=1e222acc \
  --ring-color=6ea8ffff \
  --insidever-color=1e222acc \
  --ringver-color=88c0d0ff \
  --insidewrong-color=1e222acc \
  --ringwrong-color=bf616aff \
  --line-color=00000000 \
  --separator-color=00000000 \
  --keyhl-color=a3be8cff \
  --bshl-color=bf616aff \
  --no-modkey-text
