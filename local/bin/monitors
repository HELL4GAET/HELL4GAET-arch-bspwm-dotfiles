#!/usr/bin/env bash
set -euo pipefail

internal="eDP-1"
mode="${1:-}"
desktops=(1 2 3 4 5)
external="$(xrandr --query | awk -v i="$internal" '$2 == "connected" && $1 != i {print $1; exit}')"

require_external() {
  if [[ -z "${external:-}" ]]; then
    echo "No external monitor connected" >&2
    exit 1
  fi
}

unstick_nodes() {
  bspc query -N | while read -r node; do
    bspc node "$node" -g sticky=off 2>/dev/null || true
  done || true
}

restart_picom() {
  command -v picom >/dev/null 2>&1 || return 0

  pkill -x picom 2>/dev/null || true
  while pgrep -x picom >/dev/null 2>&1; do
    sleep 0.1
  done

  picom --config "$HOME/.config/picom/picom.conf" >/tmp/picom.log 2>&1 &
}

monitor_geometry() {
  xrandr --query | awk -v monitor="$1" '
    $1 == monitor {
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
          print $i
          exit
        }
      }
    }
  '
}

sync_monitor_geometry() {
  local active="$1"
  local geometry

  sleep 0.2
  geometry="$(monitor_geometry "$active")"
  [[ -n "$geometry" ]] || return 0

  if ! bspc query -M -m "$active" >/dev/null 2>&1; then
    bspc wm -a "$active" "$geometry" 2>/dev/null || true
  fi

  bspc monitor "$active" -g "$geometry" 2>/dev/null || true
}

refresh_x() {
  bspc wm -o 2>/dev/null || true
  command -v xrefresh >/dev/null 2>&1 && xrefresh 2>/dev/null || true
}

finish_monitor() {
  local active="$1"

  unstick_nodes

  while read -r monitor; do
    if [[ "$monitor" != "$active" ]]; then
      bspc monitor "$monitor" -r 2>/dev/null || true
    fi
  done < <(bspc query -M --names)

  sync_monitor_geometry "$active"
  bspc monitor "$active" -d "${desktops[@]}"
  bspc wm -O "$active"
  unstick_nodes
  bspc desktop -f 1
  refresh_x
  restart_picom
}

use_external() {
  require_external
  unstick_nodes
  xrandr --dpi 100 --output "$external" --auto --primary --output "$internal" --off
  finish_monitor "$external"
}

use_internal() {
  unstick_nodes
  xrandr --dpi 100 --output "$internal" --auto --primary
  if [[ -n "${external:-}" ]]; then
    xrandr --output "$external" --off
  fi
  finish_monitor "$internal"
}

case "$mode" in
  external|ext)
    use_external
    ;;
  internal|laptop|lap)
    use_internal
    ;;
  *)
    echo "Usage: monitors [external|internal]" >&2
    exit 2
    ;;
esac

wallpaper || true
"$HOME/.config/polybar/launch.sh" || true
unstick_nodes
refresh_x
